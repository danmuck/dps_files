sequenceDiagram
  participant CLI as "cmd/client"
  participant KS as "KeyStore"
  participant META as "local/storage/metadata/*.toml"
  participant DHT as "DHT Storage Nodes (future)"

  CLI->>KS: "LoadAndStoreFileRemote(local_path, handler)"
  KS->>KS: "HashFile + CalculateBlockSize + PrepareMetaData"

  loop "for chunk_index in [0..TotalBlocks-1]"
    KS->>KS: "computeChunkKey(file_hash, chunk_index)"
    Note over KS,DHT: "handler (remoteHandler interface) is optional; nil skips network dispatch"
    KS->>DHT: "STORE(key, ref, data) via handler (future)"
    DHT-->>KS: "ACK/NACK (future)"
  end

  KS->>META: "fileToMemory(file refs)"
  KS-->>CLI: "File metadata persisted"

  Note over KS,DHT: "DHT distribution not yet implemented. remoteHandler redesign deferred to Stage 4."
