sequenceDiagram
  participant CN as "ClientNode"
  participant STUB as "pb.DPSFilesClient (gRPC stub)"
  participant SN as "DefaultServerNode (gRPC)"
  participant KS as "KeyStore"
  participant ML as "MetadataStore (future — Raft)"
  participant RA as "Raft Cluster (future)"
  participant BL as "BackupLedger (future)"

  CN->>STUB: "Upload(stream)"
  STUB->>SN: "gRPC client-streaming Upload RPC"
  SN->>KS: "StoreFromReader(name, r, size)"
  KS-->>SN: "FileID / error"
  SN-->>CN: "UploadResponse{hash}"

  CN->>STUB: "Download(DownloadRequest{hash})"
  STUB->>SN: "gRPC server-streaming Download RPC"
  SN->>KS: "StreamFile(fileID, w)"
  KS-->>SN: "chunk stream"
  SN-->>CN: "stream of DataChunk messages"

  KS->>ML: "UpsertFile(file_id, chunk_ids) (future)"
  ML->>RA: "Replicate metadata changes (future)"
  RA->>BL: "Snapshot + append backup block (future)"
